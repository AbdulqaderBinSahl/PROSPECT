# Copy this file to .env and fill in your own values. Never commit .env.

# ── LLM endpoint (Steps 1 and 2) ────────────────────────────────────────────
# Any OpenAI-compatible chat endpoint: a local server or a cloud API.
# Default: LM Studio on this machine.
LLM_BASE_URL=http://localhost:1234/v1

# Model ID as your server or provider names it.
# Optional for a local server (the first loaded model is used); required for a cloud API.
LLM_MODEL=

# API key. Not needed for a local server; required for a cloud API.
LLM_API_KEY=

# Examples
#   LM Studio (setup used in the paper):
#     LLM_BASE_URL=http://localhost:1234/v1
#     LLM_MODEL=openai/gpt-oss-120b
#   Ollama:
#     LLM_BASE_URL=http://localhost:11434/v1
#   OpenAI:
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=<model id>
#     LLM_API_KEY=<your key>
#   Other providers with an OpenAI-compatible endpoint work the same way:
#     set their base URL, model ID and key.

# ── Scopus (Step 1 only) ────────────────────────────────────────────────────
# Get a key at https://dev.elsevier.com/. Not needed with --skip-scopus.
SCOPUS_API_KEY=
# Optional institutional token, if your institution has one.
SCOPUS_API_INSTITUTION_KEY=
